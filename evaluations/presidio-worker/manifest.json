      "allowList": [],
      "allowListMatch": "NONE",
      "context": "DISABLED",
      "decisionProcess": true,
      "decisionProcessNote": "The supported AnalysisExplanation seam is requested, but only the patternName and recognizerId identifiers cross the boundary. text_match and pattern are raw content and are never read."
    },
    "remoteRecognizers": "none enabled; no recognizer in the pinned set performs a network call"
  },
